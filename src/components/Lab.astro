---
// Frame around an interactive widget. `title` says what it is, `try` tells the
// reader the first thing to do with it — every lab has both.
interface Props { title: string; try: string }
const { title, try: tryThis } = Astro.props;
---
<figure class="lab">
  <figcaption>
    <span class="eyebrow">Lab · {title}</span>
    <span class="try">{tryThis}</span>
  </figcaption>
  <slot />
</figure>
<style>
  .lab { margin: 8px 0 32px; padding: 28px; border: 1px solid var(--grid); border-radius: 2px; background: #100d0a; }
  figcaption { display: flex; flex-direction: column; gap: 6px; margin-bottom: 24px; }
  .try { font-style: italic; font-size: 15px; opacity: 0.85; }
  @media (max-width: 640px) { .lab { padding: 16px; margin-left: -8px; margin-right: -8px; } }
</style>
